cabal-version: 3.0
name:          backend
version:       0.1.0.0
build-type:    Simple

common warnings
  ghc-options: -Wall

library
  import:           warnings
  exposed-modules:
    Agent.Git
    Agent.Policy
    Agent.Runner
    Agent.Sandbox
    Agent.Session
    Agent.Title
    Agent.TurnSignal
    Agent.WarmSession
    Api
    ApiTypes
    App
    BuildLog
    BuildRunner
    Bus
    ClusterBus
    Config
    Docs.OpenApi
    EffectRunner
    Effects
    Fixture.Document
    Fixture.Server
    Handlers.Agent
    Handlers.Autocomplete
    Handlers.CommitHash
    Handlers.ClusterStream
    Handlers.Download
    Handlers.Presets
    Handlers.ProjectEntities
    Handlers.Projects
    Handlers.RunStep
    Handlers.SrcFiles
    Handlers.Statuses
    Handlers.StatusStream
    Handlers.StepConfig
    Handlers.StepReview
    Handlers.Steps
    Handlers.Store
    Handlers.Upload
    Handlers.Zip
    Interpreters.Fixture
    Interpreters.Production
    NixEvaluator
    NixUtils
    OutPaths
    Processes
    Sse
    UserRepo

  other-modules:
    NixEvaluator.NixRepl

  build-depends:
    , aeson
    , async
    , base               ^>=4.19.2.0
    , bytestring
    , cassava
    , conduit
    , conduit-extra
    , containers
    , data-fix
    , directory
    , effectful
    , filelock
    , filepath
    , hnix
    , http-media
    , http-types
    , lens
    , lens-aeson
    , mtl
    , network-uri
    , openapi3
    , prettyprinter
    , process
    , resourcet
    , servant
    , servant-multipart
    , servant-openapi3
    , servant-server
    , stm
    , temporary
    , text
    , time
    , tomland
    , transformers
    , unix
    , vector
    , scientific
    , wai
    , wai-cors
    , wai-extra
    , warp
    , zip-archive

  hs-source-dirs:   src
  default-language: Haskell2010
  default-extensions:
    ConstraintKinds
    FlexibleContexts
    TypeOperators

executable backend
  import:           warnings
  main-is:          Main.hs

  ghc-options:      -threaded
  build-depends:
    , backend
    , base
    , bytestring
    , directory
    , filepath
    , mtl
    , servant
    , servant-multipart
    , servant-server
    , text
    , wai
    , wai-cors
    , wai-extra
    , warp

  hs-source-dirs:   app
  default-language: Haskell2010

executable pointy-fixture-server
  import:           warnings
  main-is:          FixtureMain.hs
  ghc-options:      -threaded
  build-depends:
    , backend
    , base
    , directory
    , filepath
    , text

  hs-source-dirs:   app
  default-language: Haskell2010

executable generate-openapi
  import:           warnings
  main-is:          GenerateOpenApi.hs
  build-depends:
    , aeson-pretty
    , backend
    , base
    , bytestring

  hs-source-dirs:   app
  default-language: Haskell2010

test-suite download-metadata
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          DownloadMetadata.hs
  build-depends:
    , aeson
    , backend
    , base
    , text

  hs-source-dirs:   test
  default-language: Haskell2010

test-suite turn-stream
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          TurnStream.hs
  ghc-options:      -threaded
  build-depends:
    , backend
    , base
    , bytestring
    , directory
    , filepath
    , servant
    , stm
    , temporary
    , text
    , time

  hs-source-dirs:   test
  default-language: Haskell2010

test-suite session-store
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          SessionStore.hs
  ghc-options:      -threaded
  build-depends:
    , backend
    , base
    , directory
    , filepath
    , temporary
    , text
    , time

  hs-source-dirs:   test
  default-language: Haskell2010

test-suite certificate-status
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          CertificateStatus.hs
  build-depends:
    , aeson
    , backend
    , base
    , containers
    , stm
    , text

  hs-source-dirs:   test
  default-language: Haskell2010

test-suite submit-comment
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          SubmitComment.hs
  build-depends:
    , backend
    , base
    , effectful
    , filepath
    , temporary

  hs-source-dirs:   test
  default-language: Haskell2010

test-suite status-stream
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          StatusStreamTest.hs
  ghc-options:      -threaded
  build-depends:
    , backend
    , base
    , bytestring
    , containers
    , servant
    , stm

  hs-source-dirs:   test
  default-language: Haskell2010

test-suite dialog
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Dialog.hs
  ghc-options:      -threaded
  build-depends:
    , aeson
    , async
    , backend
    , base
    , bytestring
    , filepath
    , stm
    , temporary
    , text
    , unix

  hs-source-dirs:   test
  default-language: Haskell2010
